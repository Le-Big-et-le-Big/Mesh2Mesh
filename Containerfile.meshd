# golang:1.26.10-alpine3.24
FROM golang@sha256:27f2d3b83cfc5803c8078f8e730af0f7c431bf067afaec8f60a36fb763187cba AS build

RUN apk add --no-cache busybox-static libcap-setcap

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/bin/meshd ./cmd/meshd \
 && cp /bin/busybox.static /out/bin/ip \
 && install -d -m 0700 /out/etc/mesh2mesh

RUN setcap cap_net_admin+ep /out/bin/meshd \
 && setcap cap_net_admin+ep /out/bin/ip

# gcr.io/distroless/static-debian13:nonroot
FROM gcr.io/distroless/static-debian13@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3

COPY --from=build /out/bin/ /usr/local/bin/
COPY --from=build --chown=65532:65532 /out/etc/ /etc/

ENV MESH2MESH_STATE=/etc/mesh2mesh/peer.json
VOLUME /etc/mesh2mesh
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/meshd"]
CMD ["run"]
