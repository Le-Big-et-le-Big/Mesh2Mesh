# golang:1.26.9-trixie
FROM golang@sha256:f06b7122f888680048afb247c4e5f49c0069eb6c4c1ccae0f3f4834527a8d22c AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/meshd ./cmd/meshd

# alpine:3.22
FROM alpine@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

RUN apk add --no-cache ca-certificates iproute2
COPY --from=build /out/meshd /usr/local/bin/meshd

ENV MESH2MESH_STATE=/etc/mesh2mesh/peer.json
VOLUME /etc/mesh2mesh
ENTRYPOINT ["/usr/local/bin/meshd"]
CMD ["run"]
