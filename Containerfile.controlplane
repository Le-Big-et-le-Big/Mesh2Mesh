# golang:1.26.8-trixie
FROM golang@sha256:bdca99a00bc16590cb1a0bb4e698f5fc5d6a64e4d5eef13d9f18a0ee08e5fa65 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/controlplane ./cmd/controlplane

# alpine:3.22
FROM alpine@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

RUN apk add --no-cache ca-certificates
COPY --from=build /out/controlplane /usr/local/bin/controlplane

# LISTEN_ADDR :8090 (API), PROBE_ADDR :51821/udp
EXPOSE 8090
EXPOSE 51821/udp
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/controlplane"]
